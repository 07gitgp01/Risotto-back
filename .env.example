# --- Runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (mobile apps do not send Origin).
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
# Host port 5433 avoids clashing with a locally installed PostgreSQL on 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=risotto
DB_PASSWORD=change-me
DB_NAME=risotto
DB_TEST_NAME=risotto_test

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting (requests per window, window in ms) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Secrets (milestone 2+) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=
