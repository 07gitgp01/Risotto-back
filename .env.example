# --- Runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (mobile apps do not send Origin).
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
# Host port 5433 avoids clashing with a locally installed PostgreSQL on 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=risotto
DB_PASSWORD=change-me
DB_NAME=risotto
DB_TEST_NAME=risotto_test

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting (requests per window, window in ms) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Stricter limit on /auth/* (login, register, refresh, password reset), per IP.
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10

# --- Authentication ---
# Secrets: at least 32 characters. `npm run env:init` generates them.
# Manual: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# HMAC key for password reset codes stored in the database.
TOKEN_HASH_SECRET=
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- Email (Mailpit in local: UI on http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Risotto <no-reply@risotto.local>

# --- Messaging (milestone 6) ---
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=
